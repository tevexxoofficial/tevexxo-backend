# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== MongoDB =====
# Local Docker MongoDB (no credentials, dev only). Replace with your own URI if needed.
MONGODB_URI=mongodb+srv://neshigaravi_db_user:Neshiga_2007@tevexxocluster.tslyvyu.mongodb.net/?appName=TevexxoCluster
# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Comma-separated list of allowed frontend origins
# (Admin Panel + Main Landing Website - Vite dev server uses port 8081)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8081

# ===== Seed admin (used only by `npm run seed`) =====
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@tevexxo.com
ADMIN_PASSWORD=Admin@12345
