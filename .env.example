# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== MongoDB =====
# REQUIRED: point this at your own MongoDB instance.
# Local example:    mongodb://127.0.0.1:27017/tevexxo_admin
# Atlas example:    mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tevexxo_admin
MONGODB_URI=

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Comma-separated list of allowed frontend origins
# (Admin Panel + Main Landing Website)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080,http://localhost:8081

# ===== Seed admin (used only by `npm run seed`) =====
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@tevexxo.com
ADMIN_PASSWORD=Admin@12345
